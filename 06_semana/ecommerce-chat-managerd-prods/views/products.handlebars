<div class="panel">
    <h3 id="form-title">Agregar Producto (Admin)</h3>
    <input type="text" id="prod-title" placeholder="Nombre del producto">
    <input type="text" id="prod-description" placeholder="Agrege informacion del producto">
    <input type="text" id="prod-code" placeholder="Codigo del producto">
    <input type="number" id="prod-price" placeholder="Precio ($)">
    <label for="prod-status">Status</label>
    <input  type="checkbox" checked="checked" id="prod-status">

    <input type="number" min="0" oninput="if(value<0) value=0" id="prod-stock" placeholder="Stock">
    <input type="text" id="prod-category" placeholder="Categoria">
    <button id="add-btn">Agregar Producto</button>
    <button id="cancel-btn" style="display: none;">Cancelar Edición</button>
</div>

<div class="panel">
    <h3>Catálogo Actual</h3>
    <ul id="lista-productos">
        {{#if error}}
            <li>{{error}}</li>
        {{/if}}

        {{#each productos}}
            <li>
                <div class="product-info">
                    <strong>{{this.title}}</strong> - ${{this.price}} <br>
                    <small style="color: #666;">(ID: {{this.id}})</small>
                </div>
                <div class="product-actions">
                    <button class="btn-edit" data-id="{{this.id}}" data-title="{{this.title}}" data-price="{{this.price}}">✏️ Editar</button>
                    <button class="btn-delete" data-id="{{this.id}}">🗑️ Borrar</button>
                </div>
            </li>
        {{else}}
            <li id="no-products">No hay productos en stock.</li>
        {{/each}}
    </ul>
</div>
