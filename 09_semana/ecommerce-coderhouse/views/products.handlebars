<div class="products-header">

    <h1>Catálogo de Productos</h1>

    <p>
        {{pagination.totalItemsPerpage}}
        de
        {{pagination.totalItems}}
        productos
    </p>

    <div class="pagination">

        {{#if pagination.hasPrevPage}}
            <a href="/products?page={{pagination.prevPage}}&limit={{pagination.limit}}&sort={{pagination.sort}}">
                ← Anterior
            </a>
        {{else}}
            <span>← Anterior</span>
        {{/if}}

        <span>
            Página {{pagination.currentPage}} de {{pagination.totalPages}}
        </span>

        {{#if pagination.hasNextPage}}
            <a href="/products?page={{pagination.nextPage}}&limit={{pagination.limit}}&sort={{pagination.sort}}">
                Siguiente →
            </a>
        {{else}}
            <span>Siguiente →</span>
        {{/if}}

    </div>

</div>
</div>

<div class="products-grid">

{{#each products}}
    <div class="product-card">
        <div>
            <h2>{{title}}</h2>
            <p>{{description}}</p>
        </div>

        <div class="product-price">
            ${{price}}
        </div>
    </div>
{{/each}}

</div>
